# ==============================================================
# SMART WASTE MANAGEMENT SYSTEM - ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your actual values.
# ==============================================================

# Server Configuration
SERVER_PORT=9035
APP_BASE_URL=https://your-deployed-service.onrender.com

# Database Configuration (MySQL / TiDB Cloud)
DB_URL=jdbc:mysql://localhost:3306/smartwaste?useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_database_password

# JPA / Hibernate
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# File Uploads
UPLOAD_PATH=uploads

# Mail Configuration (SMTP - Works locally; note that Render Free Tier blocks SMTP ports)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password

# HTTP Mail APIs (RECOMMENDED for cloud hosts like Render to bypass blocked SMTP ports over HTTPS port 443)
# Get a free key at https://app.brevo.com (300 free emails/day)
BREVO_API_KEY=
# Or get a free key at https://resend.com (3000 free emails/month)
RESEND_API_KEY=

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
